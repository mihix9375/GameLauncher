{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gamelauncher",
  "version": "0.4.1",
  "identifier": "com.gamelauncher.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
		"label": "main",
        "title": "gamelauncher",
        "width": 800,
        "height": 600
	  },
	  {
		"label": "game-overlay",
		"title": "ゲームを終了",
		"url": "overlay.html",
		"width": 1920,
		"height": 1080,
		"resizable": false,
		"decorations": false,
		"transparent": true,
		"backgroundColor": "#00000000",
		"alwaysOnTop": true,
		"skipTaskbar": true,
		"shadow": false,
		"focus": false,
		"visible": false,
		"closable": false,
		"maximizable": false,
		"minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
